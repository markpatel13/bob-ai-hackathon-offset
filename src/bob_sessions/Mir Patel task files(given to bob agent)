trend_analysis.py
Report-volume trend calculations over time from processed FDA records.
"""

from __future__ import annotations

from typing import Optional

import pandas as pd


def calculate_report_trend(
    dataframe: pd.DataFrame,
    frequency: str = "ME",
    drug_name: Optional[str] = None,
    reaction: Optional[str] = None,
) -> pd.DataFrame:
    """
    Count unique FDA reports per time period.

    Parameters
    ----------
    dataframe : pandas.DataFrame
        Normalized adverse-event dataframe produced by data_processor.py.
        Must contain ``report_id`` and ``received_date`` columns.

    frequency : str
        Pandas offset alias for resampling — ``"ME"`` (month-end),
        ``"W"`` (week), or ``"D"`` (day).

    drug_name : str, optional
        If supplied, restrict to records matching this drug (case-insensitive).

    reaction : str, optional
        If supplied, restrict to records matching this reaction (case-insensitive).

    Returns
    -------
    pandas.DataFrame
        Two-column DataFrame: ``period`` (datetime) and ``report_count`` (int).
        Empty DataFrame when no dated records match the filters.
    """

    if dataframe is None or dataframe.empty:
        return pd.DataFrame(columns=["period", "report_count"])

    if "report_id" not in dataframe.columns or "received_date" not in dataframe.columns:
        return pd.DataFrame(columns=["period", "report_count"])

    records = dataframe[["report_id", "drug_name", "reaction", "received_date"]].copy()

    # ---------------------------------------------------------------
    # Optional filters
    # ---------------------------------------------------------------

    if drug_name:
        drug_upper = drug_name.strip().upper()
        records = records[
            records["drug_name"]
            .astype(str)
            .str.upper()
            .str.contains(drug_upper, regex=False, na=False)
        ]

    if reaction:
        reaction_upper = reaction.strip().upper()
        records = records[
            records["reaction"]
            .astype(str)
            .str.upper()
            .str.contains(reaction_upper, regex=False, na=False)
        ]

    if records.empty:
        return pd.DataFrame(columns=["period", "report_count"])

    # ---------------------------------------------------------------
    # One row per unique report per date
    # ---------------------------------------------------------------

    dated = records.dropna(subset=["received_date"]).drop_duplicates(
        subset=["report_id", "received_date"]
    )

    if dated.empty:
        return pd.DataFrame(columns=["period", "report_count"])

    dated = dated.copy()
    dated["received_date"] = pd.to_datetime(dated["received_date"], errors="coerce")
    dated = dated.dropna(subset=["received_date"])

    if dated.empty:
        return pd.DataFrame(columns=["period", "report_count"])

    # ---------------------------------------------------------------
    # Resample: count unique report_ids per period
    # ---------------------------------------------------------------

    dated = dated.set_index("received_date").sort_index()

    trend = (
        dated["report_id"]
        .resample(frequency)
        .nunique()
        .reset_index()
    )

    trend.columns = ["period", "report_count"]
    trend = trend[trend["report_count"] > 0].reset_index(drop=True)

    return trend


